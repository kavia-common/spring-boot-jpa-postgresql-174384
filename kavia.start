{
  "command": "./mvnw spring-boot:run -Dspring-boot.run.arguments=--server.port=3001 --server.address=0.0.0.0",
  "env": {
    "JAVA_TOOL_OPTIONS": "-XX:+UseContainerSupport"
  },
  "port": 3001,
  "notes": "Primary start uses Maven Wrapper directly. Preview must never invoke system 'mvn'. If permissions are restrictive, ensure './mvnw' is executable (chmod +x ./mvnw). The run.sh/start.sh remain available for convenience."
}
