#!/usr/bin/env bash
# Shim script to proxy any 'mvn' invocation to the Maven Wrapper './mvnw'.
# This ensures environments that hardcode 'mvn' will still use the project-pinned Maven distribution.
# Usage:
#   ./mvn <args...>
# Behavior:
#   - Ensures ./mvnw exists and is executable.
#   - Execs ./mvnw passing all provided arguments transparently.

set -euo pipefail

# Ensure mvnw is present
if [[ ! -f "./mvnw" ]]; then
  echo "ERROR: ./mvnw is missing. This project requires the Maven Wrapper; no global 'mvn' fallback." >&2
  exit 127
fi

# Ensure mvnw is executable
if [[ ! -x "./mvnw" ]]; then
  chmod +x ./mvnw || true
fi

# Ensure this shim is executable as well (helps on some systems copying without x bit)
if [[ ! -x "$0" ]]; then
  chmod +x "$0" || true
fi

# Proxy to mvnw with all arguments
exec ./mvnw "$@"
